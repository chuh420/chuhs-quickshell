#!/bin/bash
shell_call() {
    /home/chuh/.local/bin/pleamar --say material "emit $1"
}
case "$1" in
    launcher) shell_call launcher ;;
    menu) shell_call menu ;;
    notifications) shell_call close; swaync-client -t ;;
    volume-up) swayosd-client --max-volume 100 --output-volume raise ;;
    volume-down) swayosd-client --output-volume lower ;;
    volume-mute) swayosd-client --output-volume mute-toggle ;;
    microphone-mute) swayosd-client --input-volume mute-toggle ;;
    brightness-key-up) swayosd-client --brightness +5 ;;
    brightness-key-down) swayosd-client --min-brightness 5 --brightness -5 ;;
    audio) pavucontrol ;;
    network) shell_call wifi ;;
    bluetooth) shell_call bluetooth ;;
    clipboard) shell_call close; cliphist list | rofi -dmenu -p 'Clipboard' | cliphist decode | wl-copy ;;
    lock) shell_call close; pidof hyprlock >/dev/null || hyprlock ;;
    suspend) systemctl suspend ;;
    power) shell_call close; choice=$(printf 'Lock\nSleep\nRestart\nPower off' | rofi -dmenu -p 'Session'); case "$choice" in Lock) "$0" lock ;; Sleep) systemctl suspend ;; Restart) systemctl reboot ;; "Power off") systemctl poweroff ;; esac ;;
    screenshot) shell_call close; region=$(slurp -b '#1d2021cc' -c '#a9b665' -w 2) || exit; mkdir -p "$HOME/Pictures/Screenshots"; file="$HOME/Pictures/Screenshots/$(date +%Y-%m-%d_%H-%M-%S).png"; grim -g "$region" "$file" && satty --filename "$file" --copy-command wl-copy ;;
    screenshot-output) mkdir -p "$HOME/Pictures/Screenshots"; file="$HOME/Pictures/Screenshots/$(date +%Y-%m-%d_%H-%M-%S).png"; grim "$file" && wl-copy < "$file" ;;
    wallpaper) shell_call wallpapers ;;
esac
