part Widgets {
    component ActionChip(label: text, action: number, tone: color = panel_ink, checked: bool = false, tip: number = 0, secondary: number = 0, fixed_width: number = 0, chosen: event = command) {
        measure caption
        prop pressed = 0 ~100ms
        prop hot = 0 ~spring(650, 34)
        let chip_width = if(fixed_width > 0, fixed_width, caption.width + 29.28)
        row { size: chip_width, 36.6
            group { size: chip_width, 36.6; pivot: chip_width / 2, 18.3; scale: 1 - pressed * 0.045; move: 0, -hot * 1.3
                box hit { from: 0, 0; size: chip_width, 36.6; corner: 12.2; color: panel_elevated; opacity: max(hot, checked); cursor: pointer; label: label }
                text label { at: chip_width / 2, 18.3; anchor: center; size: 14.64; family: "JetBrainsMono Nerd Font Mono"; color: tone; measure: caption }
                on enter hit { hot: 1 ~140ms }
                on leave hit { hot: 0 ~140ms; pressed: 0; emit tip_hide }
                on release hit { pressed: 0 ~spring(650, 28) }
                on press hit { pressed: 1; emit tip_hide; emit chosen(action) }
                on press right hit while secondary > 0 { emit tip_hide; emit command(secondary) }
                on hover hit for 650ms while tip > 0 { tip_origin = screen.index; tip_x = pointer.x - local.x + chip_width / 2; tip_y = pointer.y - local.y - 8; tip_below = false; emit tip_show(tip) }
            }
        }
    }
    component IconChip(label: text, action: number, tone: color = panel_ink, tip: number = 0) {
        measure caption
        prop pressed = 0 ~100ms
        prop hot = 0 ~spring(650, 34)
        let chip_width = caption.width + 29.28
        row { size: chip_width, 36.6
            group { size: chip_width, 36.6; pivot: chip_width / 2, 18.3; scale: 1 - pressed * 0.045; move: 0, -hot * 1.3
                box hit { from: 0, 0; size: chip_width, 36.6; corner: 12.2; color: panel_elevated; opacity: hot; cursor: pointer; label: label }
                text label { at: chip_width / 2, 18.3; anchor: center; size: 21.96; family: "JetBrainsMono Nerd Font Mono"; color: tone; measure: caption }
                on enter hit { hot: 1 ~140ms }
                on leave hit { hot: 0 ~140ms; pressed: 0; emit tip_hide }
                on release hit { pressed: 0 ~spring(650, 28) }
                on press hit { pressed: 1; emit tip_hide; emit command(action) }
                on hover hit for 650ms while tip > 0 { tip_origin = screen.index; tip_x = pointer.x - local.x + chip_width / 2; tip_y = pointer.y - local.y - 8; tip_below = false; emit tip_show(tip) }
            }
        }
    }
    component MaterialSlider(width: number, value: number, low: number, high: number, tone: color, changed: event, tip: number = 0) {
        size: width, 39.04
        prop slider_position = 0 ~140ms
        follow slider_position = clamp((value - low) / (high - low), 0, 1)
        let position = slider_position
        let track_width = width - 17.08
        box { from: 8.54, 15.86; size: track_width, 7.32; corner: 3.66; color: panel_elevated }
        box { from: 8.54, 15.86; size: track_width * position, 7.32; corner: 3.66; color: tone }
        box { from: 8.54 + position * (track_width - 17.08), 10.98; size: 17.08, 17.08; corner: 7.32; color: panel_ink }
        zone box hit { from: 0, 0; size: width, 39.04; cursor: pointer; role: slider; label: "slider"; value: value }
        on press hit { emit changed(low + clamp((local.x - 17.08) / max(1, track_width - 17.08), 0, 1) * (high - low)) }
        on drag hit { emit changed(low + clamp((local.x - 17.08) / max(1, track_width - 17.08), 0, 1) * (high - low)) }
        on leave hit { emit tip_hide }
        on hover hit for 650ms while tip > 0 { tip_origin = screen.index; tip_x = pointer.x - local.x + width / 2; tip_y = pointer.y - local.y - 8; tip_below = false; emit tip_show(tip) }
    }
    component DeviceChip(d: record, width: number, source: bool) {
        size: width, 36.6
        prop hot = 0 ~spring(650, 34)
        box hit { from: 0, 0; size: width, 36.6; corner: 12.2; color: panel_elevated; opacity: hot; cursor: pointer; label: d.name }
        text d.name { at: width / 2, 18.3; anchor: center; width: width - 20; lines: 1; size: 14.64; family: "JetBrainsMono Nerd Font Mono"; color: panel_ink; show: not d.default }
        text "✓  {d.name}" { at: width / 2, 18.3; anchor: center; width: width - 20; lines: 1; size: 14.64; family: "JetBrainsMono Nerd Font Mono"; color: sage; show: d.default }
        on enter hit { hot: 1 ~140ms }
        on leave hit { hot: 0 ~140ms }
        on press hit { emit audio_device(if(source, -d.index - 1, d.index + 1)) }
    }
}
