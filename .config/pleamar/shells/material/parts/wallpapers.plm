part Wallpapers {
    group { show: panel == 4
        text "desktop / wallpapers" { at: 0, 0; size: 11; family: "JetBrainsMono Nerd Font Mono"; color: sage; letter_move: letter * 1.3, 0 }
        text "wallpapers" { at: -1, 22; size: 32; family: "Adwaita Sans"; color: panel_ink }
        text "{count} images · Pictures/Wallpapers" { at: 0, 65; size: 13.42; family: "Adwaita Sans"; color: panel_muted }
        row { at: content_width, 25; anchor: right; gap: 14.64
            ActionChip("refresh", 23)
            ActionChip("×", 27)
        }
        let cell_width = content_width / 2
        let cell_height = cell_width * 9 / 16 + 65.88
        let tile_width = cell_width - 12.2
        let tile_height = cell_height - 12.2
        let gallery_height = content_height - 139.56
        column gallery_list { at: 0, 104.72; view: content_width, gallery_height; step: 73.2; content: ceil(count / 2) * cell_height; gap: 0
            for p in pictures from offset {
                group { size: content_width, cell_height / 2; move: 0, floor(offset / 2) * cell_height - mod(p.index, 2) * cell_height / 2
                    group { move: mod(p.index, 2) * cell_width, (1 - clamp(content_motion * 1.6 - mod(p.index, 2) * 0.14, 0, 1)) * 20; opacity: clamp(content_motion * 1.6 - mod(p.index, 2) * 0.14, 0, 1); size: tile_width, tile_height
                        prop hot = 0 ~140ms
                        box hit { from: 0, 0; size: tile_width, tile_height; corner: 17.08; color: mix(panel_surface, panel_elevated, hot); cursor: pointer; label: p.name }
                        box { from: 0, 0; size: tile_width, tile_height; corner: 17.08; color: mix(panel_line, sage, max(p.active, p.selected)); stroke: 1.22 }
                        image p.picture { at: 8.54, 8.54; size: tile_width - 17.08, (tile_width - 17.08) * 9 / 16 }
                        text p.name { at: 15.86, tile_height - 33; width: tile_width - if(p.active, 111, 31.72); lines: 1; size: 14.64; family: "Adwaita Sans"; color: panel_ink }
                        text "✓ applied" { at: tile_width - 15.86, tile_height - 23.2; anchor: right center; size: 12.2; family: "Adwaita Sans"; color: sage; show: p.active }
                        on enter hit { hot: 1 ~140ms }
                        on leave hit { hot: 0 ~140ms }
                        on press hit { emit choose(p.index) }
                    }
                }
            }
        }
        prop gallery_hover = 0 ~140ms
        on enter gallery_list { gallery_hover: 1 ~140ms }
        on leave gallery_list { gallery_hover: 0 ~140ms }
        let scroll_height = max(24, gallery_height * gallery_height / max(ceil(count / 2) * cell_height, gallery_height))
        box { from: content_width - 4, 104.72 + gallery_list.scroll / max(1, ceil(count / 2) * cell_height - gallery_height) * (gallery_height - scroll_height); size: 3, scroll_height; corner: 1.5; color: panel_ink; opacity: gallery_hover * 55%; show: ceil(count / 2) * cell_height > gallery_height }
        text "add images to Pictures/Wallpapers" { at: content_width / 2, 104.72 + gallery_height / 2; anchor: center; size: 14.64; family: "Adwaita Sans"; color: panel_muted; show: count == 0 }
        text message { at: 0, content_height - 40; width: content_width; lines: 1; size: 13.42; family: "Adwaita Sans"; color: red }
        text wallpaper_help { at: 0, content_height - 16.1; width: content_width; lines: 1; size: 13.42; family: "Adwaita Sans"; color: panel_muted }
        on change floor(gallery_list.scroll / cell_height) while panel == 4 and screen.index == origin { emit list_scrolled(floor(gallery_list.scroll / cell_height) * 2) }
        on list_reset { gallery_list.scroll: 0 }
        on selection_changed while panel == 4 and screen.index == origin {
            gallery_list.scroll: clamp(if(floor(selected / 2) * cell_height < gallery_list.scroll, floor(selected / 2) * cell_height, if(floor(selected / 2) * cell_height + tile_height > gallery_list.scroll + gallery_height, floor(selected / 2) * cell_height + tile_height - gallery_height, gallery_list.scroll)), 0, max(0, ceil(count / 2) * cell_height - gallery_height))
        }
    }
}
