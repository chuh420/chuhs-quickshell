scene OptimizationFixture {
    surface { size: 640, 480; anchor: center; reserve: -1; keyboard: none; level: overlay }
    box { from: 0, 0; size: 640, 480; color: #282828 }
    box { from: 20, 20; size: 180, 90; corner: 18; color: #a9b665 }
    box { from: 220, 20; size: 180, 90; corner: 18; stroke: 2.3; color: #d8a657 }
    body { color: #d4be98; shadow: 3, 8, 14, 40%; rim: 8%; box { from: 420, 20; size: 180, 90; corner: 24 } }
    body { gradient: 20, 150 to 200, 250, #a9b665, #ea6962; box { from: 20, 150; size: 180, 100; corner: 20 } }
    body { color: #83a598; ellipse { at: 280, 190; radius: 42 }; box { from: 290, 150; size: 100, 90; corner: 14; blend: 12 } }
    group { opacity: 65%; rotate: 7deg; pivot: 500, 200
        box { from: 425, 150; size: 150, 100; corner: 20; color: #d3869b }
        ellipse { at: 540, 185; radius: 34; color: #8ec07c }
    }
    body { color: #d4be98; glass: 75%; shadow: 0, 4, 10, 30%; box { from: 20, 300; size: 260, 110; corner: 25 } }
    text "plain, stroked, shadowed, merged" { at: 24, 436; size: 18; family: "Adwaita Sans"; color: #d4be98 }
    text "glass and text" { at: 45, 340; size: 23; family: "Adwaita Sans"; color: #282828 }
    ellipse { at: 470, 350; radius: 60; rotate: -18deg; color: #d8a657; opacity: 58% }
}
